{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    //"baseUrl": ".",
    //"ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "ChoiceModal.tsx",
    "FactionPanel.tsx",
    "QuestPanels.tsx",
    "RivalsPanel.tsx",
    "eventResolver.ts",
    "src/tests",
    "src/test"
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.d.ts",
    "dist",
    "node_modules",
    "tests",
    "test",
    "src/demo/**",
    "src/**/*.stories.*",
    "StorySystem.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
