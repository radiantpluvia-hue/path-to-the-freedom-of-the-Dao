{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": ".tmp_build",
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/**/*",
    "ChoiceModal.tsx",
    "FactionPanel.tsx",
    "QuestPanels.tsx",
    "RivalsPanel.tsx",
    "eventResolver.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "test",
    "src/demo",
    "src/test",
    "src/tests",
    "src/test_helpers",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ]
}

