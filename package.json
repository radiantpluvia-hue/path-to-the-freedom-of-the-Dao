{
  "name": "xianxia-cultivation-game",
  "version": "1.0.1",
  "description": "A React-based Xianxia cultivation game with TypeScript and Zustand",
  "type": "module",
  "scripts": {
  "dev": "vite",
  "build": "npm run build:node && vite build",
  "build:node": "tsc -p tsconfig.cjs.json && node scripts/helpers/rename_build_js_to_cjs.cjs",
    "preview": "vite preview",
  "test": "jest",
  "verify:content": "node scripts/verify/run_all.cjs",
    "release": "npm run build && powershell -Command \"Compress-Archive -Path dist/* -DestinationPath release.zip -Force\"",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.8",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
  "jest-environment-jsdom": "^28.1.1",
    "@types/jest": "^29.5.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jest": "^29.7.0",
    "terser": "^5.44.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.2",
    "vite": "^7.1.3"
  }
}
