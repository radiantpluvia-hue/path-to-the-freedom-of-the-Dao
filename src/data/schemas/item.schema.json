{
  "$id": "item.schema.json",
  "type": "object",
  "required": ["id", "name", "rarity"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "rarity": { "type": "string", "enum": ["common","uncommon","rare","epic","legendary"] },
    "description": { "type": "string" },
    "effects": { "type": ["array","null"] }
  },
  "additionalProperties": true
}
